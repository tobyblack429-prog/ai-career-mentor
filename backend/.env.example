# ═══════════════════════════════════════════════════════════════════════════
# AI Career Mentor — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

APP_ENV=development
# Local demo mode only. Keep authentication enabled when publishing the site.
AUTH_DISABLED=true

# --- DATABASE SETTINGS ---
# Production: Use PostgreSQL (e.g., Neon, Supabase, AWS RDS)
# DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@host:5432/dbname?sslmode=require
# Local Development: SQLite (default)
DATABASE_URL=sqlite:///./dev.db


# ═══════════════════════════════════════════════════════════════════════════
# LLM PROVIDER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Available providers: groq, gemini, nvidia, siliconflow
# To use SiliconFlow only, set LLM_PROVIDER=siliconflow in your private .env.
# This mode never falls back to another provider. Check the model's live price
# before use; a provider may change which models are free.
# 
# LLM Model Router Architecture:
#   Each agent now gets its OWN provider + model based on capability:
#     - Resume Agent     → Groq (structured JSON)
#     - Market Agent     → Groq (reasoning, fast + free)
#     - LinkedIn Agent   → Groq (creative content)
#     - Roadmap          → Groq + Gemini (hybrid)
#     - Interview        → Groq (low-latency streaming)
# ═══════════════════════════════════════════════════════════════════════════

# --- GLOBAL DEFAULTS (used when no per-agent override exists) ---
LLM_PROVIDER=groq

# --- API KEYS ---
# Get keys from respective provider dashboards
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_google_gemini_key_here
NVIDIA_API_KEY=your_nvidia_nim_key_here
SILICONFLOW_API_KEY=your_siliconflow_key_here

# --- GLOBAL MODEL DEFAULTS ---
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_MODEL=gemini-3.5-flash
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
SILICONFLOW_MODEL=XingChenAGI/Xing4.0-29B


# ───────────────────────────────────────────────────────────────────────────
# PER-AGENT LLM MODEL MAPPING
# ───────────────────────────────────────────────────────────────────────────
# Each agent gets a dedicated provider + model + temperature.
# Unset variables fall back to defaults in app/core/llm_config.py.
# Format: AGENT_<NAME>_PROVIDER=<provider>
#         AGENT_<NAME>_MODEL=<model>
#         AGENT_<NAME>_TEMPERATURE=<float>
#
# Current Agent Profiles:
#   Agent              | Capability         | Default Provider | Default Model
#   ───────────────────┼────────────────────┼─────────────────┼──────────────────────────
#   resume             | structured_json    | groq             | openai/gpt-oss-120b
#   market             | reasoning          | gemini           | gemini-3.5-flash
#   market_intelligence| reasoning          | gemini           | gemini-3.5-flash
#   linkedin           | creative           | gemini           | gemini-3.5-flash
#   roadmap_structure  | reasoning          | groq             | openai/gpt-oss-120b
#   roadmap_details    | cheap              | groq             | openai/gpt-oss-120b
#   interview          | fast_streaming     | groq             | openai/gpt-oss-20b
#   interview_feedback | reasoning          | groq             | openai/gpt-oss-120b
# ───────────────────────────────────────────────────────────────────────────

# Resume Agent → Structured JSON (use Groq)
# AGENT_RESUME_PROVIDER=groq
# AGENT_RESUME_MODEL=openai/gpt-oss-120b
# AGENT_RESUME_TEMPERATURE=0.3

# Market Agent → Reasoning (use Gemini)
# AGENT_MARKET_PROVIDER=gemini
# AGENT_MARKET_MODEL=gemini-3.5-flash
# AGENT_MARKET_TEMPERATURE=0.2

# Market Intelligence → Reasoning (use Gemini — high TPM for web-summary synthesis)
# AGENT_MARKET_INTELLIGENCE_PROVIDER=gemini
# AGENT_MARKET_INTELLIGENCE_MODEL=gemini-3.5-flash

# LinkedIn Strategy → Creative content (use Gemini)
# AGENT_LINKEDIN_PROVIDER=gemini
# AGENT_LINKEDIN_MODEL=gemini-3.5-flash
# AGENT_LINKEDIN_TEMPERATURE=0.7

# Roadmap Structure → Complex reasoning (use Groq)
# AGENT_ROADMAP_STRUCTURE_PROVIDER=groq
# AGENT_ROADMAP_STRUCTURE_MODEL=openai/gpt-oss-120b
# AGENT_ROADMAP_STRUCTURE_TEMPERATURE=0.4

# Roadmap Details → Batch processing (use Groq)
# AGENT_ROADMAP_DETAILS_PROVIDER=groq
# AGENT_ROADMAP_DETAILS_MODEL=openai/gpt-oss-120b
# AGENT_ROADMAP_DETAILS_TEMPERATURE=0.5

# Interview Streaming → Low latency (use Groq)
# AGENT_INTERVIEW_PROVIDER=groq
# AGENT_INTERVIEW_MODEL=openai/gpt-oss-20b
# AGENT_INTERVIEW_TEMPERATURE=0.65

# Interview Feedback → Reasoning (use Groq)
# AGENT_INTERVIEW_FEEDBACK_PROVIDER=groq
# AGENT_INTERVIEW_FEEDBACK_MODEL=openai/gpt-oss-120b
# AGENT_INTERVIEW_FEEDBACK_TEMPERATURE=0.3


# ═══════════════════════════════════════════════════════════════════════════
# JWT & AUTH
# ═══════════════════════════════════════════════════════════════════════════
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret


# ═══════════════════════════════════════════════════════════════════════════
# REDIS (for rate limiting & caching)
# ═══════════════════════════════════════════════════════════════════════════
# Use Upstash (serverless Redis) or local Redis
# REDIS_URL=rediss://<REDIS_USER>:<REDIS_PASSWORD>@host:6379


# ═══════════════════════════════════════════════════════════════════════════
# SEARCH ENGINES
# ═══════════════════════════════════════════════════════════════════════════
# SERPER_API_KEY=your_serper_key
# TAVILY_API_KEY=your_tavily_key
# BING_SEARCH_API_KEY=your_bing_key


# ═══════════════════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════════════════
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.vercel.app


# ═══════════════════════════════════════════════════════════════════════════
# OBSERVABILITY
# ═══════════════════════════════════════════════════════════════════════════
ENABLE_OBSERVABILITY=true
SENTRY_DSN=your_sentry_dsn_if_available
ADMIN_EMAIL=admin@example.com
